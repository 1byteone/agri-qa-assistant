{
  "project": "AgriQA Assistant",
  "description": "Agricultural Intelligent QA Prototype System",
  "version": "1.0.0",
  "screenshots": [
    {
      "id": "homepage",
      "name": "Homepage",
      "url": "http://localhost:3000",
      "viewport": {
        "width": 1280,
        "height": 800
      },
      "waitFor": 3000,
      "selector": "main"
    },
    {
      "id": "chat-interface",
      "name": "Chat Interface",
      "url": "http://localhost:3000",
      "viewport": {
        "width": 1280,
        "height": 800
      },
      "waitFor": 3000,
      "actions": [
        {
          "type": "click",
          "selector": "textarea"
        },
        {
          "type": "type",
          "text": "水稻稻飞虱怎么防治？"
        },
        {
          "type": "wait",
          "ms": 2000
        },
        {
          "type": "click",
          "selector": "button[type='submit']"
        }
      ],
      "waitFor": 5000,
      "selector": "main"
    },
    {
      "id": "mobile-view",
      "name": "Mobile View",
      "url": "http://localhost:3000",
      "viewport": {
        "width": 375,
        "height": 812
      },
      "waitFor": 3000,
      "selector": "main"
    }
  ],
  "output": {
    "directory": "./docs/screenshots",
    "format": "png",
    "quality": 100
  },
  "browser": {
    "type": "chromium",
    "headless": true,
    "args": ["--no-sandbox"]
  }
}
