    "    ...\n",
    "\n",
    "# 自定义工具名称\n",
    "@tool(\"get_today_date\")\n",
    "def get_current_date() -> str:\n",
    "    \"\"\"获取本机系统当前年月日、星期\"\"\"\n",
    "    ...\n",
    "\n",
    "# 带参数的精细化工具\n",
    "@tool\n",
    "def get_weather_for_location(city: str) -> str:\n",
    "    \"\"\"\n",
    "    获取指定中文城市�?天天气预报\n",
