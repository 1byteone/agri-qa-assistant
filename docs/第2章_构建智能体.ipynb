    "from pydantic import BaseModel, Field\n",
    "\n",
    "# 定义结构化输出模型\n",
    "class WeatherOutput(BaseModel):\n",
    "    city: str = Field(description=\"查询目标城市名称\")\n",
    "    temperature: str = Field(description=\"当日温度\")\n",
    "    weather: str = Field(description=\"天气状况，如多云、阵雨\")\n",
    "\n",
    "# �?create_agent 中指�?response_format\n",
    "structured_agent = create_agent(\n",
    "    model=llm,\n",
    "    tools=[get_weather_for_location],\n",
    "    system_prompt=WEATHER_SYSTEM_PROMPT,\n",
    "    response_format=WeatherOutput  # 强制结构化输出\n",
    ")\n",
    "\n",
    "# 调用后通过 structured_response 获取结构化结果\n",
    "if __name__ == \"__main__\":\n",
    "    result = structured_agent.invoke({\n",
    "        \"messages\": [{\"role\": \"user\", \"content\": \"查询北京天气\"}]\n",
    "    })\n",
    "    print(\"结构化输出结果：\")\n",
    "    print(result[\"structured_response\"])  # 返回 WeatherOutput 对象\n",
    "    print(f\"\\n城市：{result['structured_response'].city}\")\n",
    "    print(f\"温度：{result['structured_response'].temperature}\")\n",
    "    print(f\"天气：{result['structured_response'].weather}\")"
